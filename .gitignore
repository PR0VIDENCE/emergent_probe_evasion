# ---------- Data and outputs ----------
# Large/generated artifacts under data/ are ignored by default.
# Whitelist subdirs that should be tracked.
data/*
!data/concepts/
!data/generation_prompt_templates/

# Downloaded benchmark data (re-fetchable from upstream)
data/concepts/*/sharma_answer.jsonl

# Per-concept run output directories (rollouts, activations, summaries — regenerable)
data/concepts/*/stage*/

# Multiplication pilot — large/regenerable artifacts. Keep input/reference
# files (problems.jsonl, raw/ word-problem JSONLs) but ignore model outputs
# and probe analyses since they're reproducible from those inputs.
data/concepts/multiplication_pilot/probes*/
data/concepts/multiplication_pilot/probe_*_strategy*/
data/concepts/multiplication_pilot/*/qwq_local/
data/concepts/multiplication_pilot/*/activations/
data/concepts/multiplication_pilot/calibration*/api_*/rollouts*.jsonl
data/concepts/multiplication_pilot/calibration*/api_*/summary*.json
# Dashboard build output (single HTML file regenerated from above)
data/concepts/multiplication_pilot/dashboard.html

# Numeric artifacts
*.pt
*.pkl
*.npy
*.npz

# Model weights (anywhere)
*.ckpt
*.bin
*.safetensors
*.h5
*.pth

# ---------- Experiment tracking ----------
wandb/
mlruns/
*.log

# ---------- Environment ----------
.env
.env.*
.venv
env/
venv/
ENV/

# uv lockfile — intentionally ignored (platform-conditional torch index causes
# Mac/Linux merge conflicts). Reproducibility tradeoff is documented in README.
uv.lock

